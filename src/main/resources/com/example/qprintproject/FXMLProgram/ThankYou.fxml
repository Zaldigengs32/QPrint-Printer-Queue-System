<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane minHeight="720.0" minWidth="1280.0" prefHeight="1080.0" prefWidth="1920.0" style="-fx-background-color: linear-gradient(to bottom, #002846, #002846); -fx-background-radius: 0;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.qprintproject.Controller.ThankYouController">

    <center>
        <VBox alignment="CENTER" fillWidth="true" spacing="50.0">
            <padding>
                <Insets bottom="80.0" left="100.0" right="100.0" top="80.0" />
            </padding>

            <VBox alignment="CENTER" spacing="25.0">
                <StackPane />
                <Text fx:id="mainTitle" fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="QPrint" textAlignment="CENTER" wrappingWidth="1025.5804443359375">
                    <font>
                        <Font name="Arial Black" size="48.0" />
                    </font>
                    <effect>
                        <DropShadow color="#2980b9" height="20.0" radius="10.0" width="20.0" />
                    </effect>
                </Text>
            </VBox>

            <VBox alignment="CENTER" maxWidth="800.0" spacing="25.0">
                <Label fx:id="thankYouLabel" style="-fx-font-size: 64px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI', Arial, sans-serif;" text="Terima Kasih!" textAlignment="CENTER" textFill="WHITE" />
                <Label fx:id="messageLabel" style="-fx-font-size: 24px; -fx-font-family: 'Segoe UI', Arial, sans-serif;" text="Telah menggunakan QPrint untuk kebutuhan pencetakan Anda" textAlignment="CENTER" textFill="WHITE" wrapText="true" />
                <Label fx:id="subMessageLabel" style="-fx-font-size: 18px; -fx-font-family: 'Segoe UI', Arial, sans-serif;" text="Dokumen Anda telah berhasil dicetak dengan kualitas terbaik" textAlignment="CENTER" textFill="#B8D4F0" wrapText="true" />
            </VBox>

            <HBox alignment="CENTER" fillHeight="false" spacing="80.0">
                <VBox alignment="CENTER" minWidth="150.0" spacing="15.0">
                    <Label fx:id="pagesCountLabel" style="-fx-font-size: 72px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI', Arial, sans-serif;" textFill="WHITE" />
                    <Label style="-fx-font-size: 20px; -fx-font-family: 'Segoe UI', Arial, sans-serif;" text="Halaman" textFill="#B8D4F0" />
                </VBox>

                <Line endX="0" endY="50" opacity="0.5" startX="0" startY="-50" stroke="#B8D4F0" strokeWidth="2" />

                <VBox alignment="CENTER" minWidth="150.0" spacing="15.0">
                    <Label fx:id="timeLabel" style="-fx-font-size: 72px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI', Arial, sans-serif;" textFill="WHITE" />
                    <Label style="-fx-font-size: 20px; -fx-font-family: 'Segoe UI', Arial, sans-serif;" text="Waktu Cetak" textFill="#B8D4F0" />
                </VBox>

                <Line endX="0" endY="50" opacity="0.5" startX="0" startY="-50" stroke="#B8D4F0" strokeWidth="2" />

                <VBox alignment="CENTER" minWidth="150.0" spacing="15.0">
                    <Label fx:id="qualityLabel" style="-fx-font-size: 72px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI', Arial, sans-serif;" textFill="WHITE" />
                    <Label style="-fx-font-size: 20px; -fx-font-family: 'Segoe UI', Arial, sans-serif;" text="Kualitas" textFill="#B8D4F0" />
                </VBox>
            </HBox>

            <HBox alignment="CENTER" spacing="40.0">
                <Button fx:id="closeButton" onAction="#handleClose" prefHeight="60.0" prefWidth="220.0" style="-fx-background-color: transparent; -fx-text-fill: WHITE; -fx-border-color: WHITE; -fx-border-width: 2; -fx-border-radius: 30; -fx-background-radius: 30; -fx-font-size: 18px; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-family: 'Segoe UI', Arial, sans-serif;" text="Selesai" />
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER">
            <padding>
                <Insets bottom="30.0" left="50.0" right="50.0" top="30.0" />
            </padding>
            <HBox alignment="CENTER" spacing="20.0">
                <children>
                    <Label text="Kadek Bintang Januarta" textFill="#85c1e9">
                        <font>
                            <Font name="Arial" size="14.0" />
                        </font>
                    </Label>
                    <Label text="•" textFill="#85c1e9">
                        <font>
                            <Font name="Arial Bold" size="18.0" />
                        </font>
                    </Label>
                    <Label text="M. Zaldi Aprialdi" textFill="#85c1e9">
                        <font>
                            <Font name="Arial" size="14.0" />
                        </font>
                    </Label>
                    <Label text="•" textFill="#85c1e9">
                        <font>
                            <Font name="Arial Bold" size="18.0" />
                        </font>
                    </Label>
                    <Label text="Adhittya Tubagus Syahroni" textFill="#85c1e9">
                        <font>
                            <Font name="Arial" size="14.0" />
                        </font>
                    </Label>
                    <Label text="•" textFill="#85c1e9">
                        <font>
                            <Font name="Arial Bold" size="18.0" />
                        </font>
                    </Label>
                    <Label text="Nazla Nurul Aini" textFill="#85c1e9">
                        <font>
                            <Font name="Arial" size="14.0" />
                        </font>
                    </Label>
                </children>
            </HBox>
        </HBox>
    </bottom>
</BorderPane>