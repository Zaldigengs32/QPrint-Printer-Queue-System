<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.qprintproject.Controller.MainProgramController">
    <top>
        <VBox alignment="CENTER" prefHeight="168.0" prefWidth="1580.0" style="-fx-background-color: #002846; -fx-padding: 40 30 40 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 5);">
         <Text fx:id="mainTitle" fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="QPrint: Sistem Antrian Cetak Dokumen" textAlignment="CENTER" wrappingWidth="1025.5804443359375">
            <font>
               <Font name="Arial Black" size="48.0" />
            </font>
            <effect>
               <DropShadow color="#2980b9" height="20.0" radius="10.0" width="20.0" />
            </effect>
         </Text>
         <Text fill="#85c1e9" strokeType="OUTSIDE" strokeWidth="0.0" textAlignment="CENTER" wrappingWidth="376.875">
            <font>
               <Font name="Arial Bold Italic" size="20.0" />
            </font>
         </Text>
         <Text fill="#85c1e9" strokeType="OUTSIDE" strokeWidth="0.0" text="&quot;ONE System, ONE Click, For EveryONE&quot;" textAlignment="CENTER" wrappingWidth="442.47491455078125">
            <font>
               <Font name="Arial Bold Italic" size="20.0" />
            </font>
         </Text>
        </VBox>
    </top>
    <center>
        <TabPane fx:id="mainTabPane" style="-fx-background-color: #f5f7fa; -fx-tab-min-width: 200px; -fx-tab-max-width: 200px;" tabClosingPolicy="UNAVAILABLE">

            <Tab text="➕ Tambah Dokumen">
                <ScrollPane fitToWidth="true" style="-fx-background: #f5f7fa; -fx-background-color: transparent;">
                    <content>
                        <VBox prefHeight="563.0" prefWidth="1580.0" spacing="25.0" style="-fx-padding: 40;">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <Region HBox.hgrow="ALWAYS" />
                            </HBox>
                              <Button fx:id="selectFileButton" onAction="#selectFile" prefHeight="56.0" prefWidth="1500.0" style="-fx-background-color: #1e6091; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 15 30; -fx-background-radius: 25; -fx-effect: dropshadow(gaussian, rgba(66,153,225,0.52), 10, 0, 0, 5); -fx-cursor: hand;" text="📁 Pilih Dokumen" />

                            <VBox spacing="30.0">
                                <HBox spacing="15">
                                    <Region HBox.hgrow="ALWAYS" />
                                </HBox>

                                <VBox spacing="25.0" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);">
                                    <HBox alignment="CENTER_LEFT" spacing="25">
                                        <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #2d3748;" text="📄 Nama Dokumen:" />
                                            <TextField fx:id="docNameField" disable="true" maxWidth="Infinity" prefHeight="58.0" prefWidth="200.0" style="-fx-background-color: #f7fafc; -fx-border-color: #e2e8f0; -fx-border-width: 2; -fx-border-radius: 12; -fx-padding: 12; -fx-font-size: 14;" />
                                        </VBox>
                                        <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #2d3748;" text="📋 Jenis Dokumen:" />
                                            <ComboBox fx:id="docTypeCombo" disable="true" maxWidth="Infinity" prefWidth="160.0" style="-fx-background-color: #f7fafc; -fx-border-color: #e2e8f0; -fx-border-width: 2; -fx-border-radius: 12; -fx-padding: 12; -fx-font-size: 14;" />
                                        </VBox>
                                    </HBox>

                                    <HBox alignment="CENTER_LEFT" spacing="25">
                                        <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #2d3748;" text="📊 Jumlah Salinan:" />
                                            <Spinner fx:id="copiesSpinner" maxWidth="Infinity" minWidth="30.0" prefHeight="59.0" prefWidth="80.0" style="-fx-background-color: #f7fafc; -fx-border-color: #e2e8f0; -fx-border-width: 2; -fx-border-radius: 12;" />
                                        </VBox>
                                        <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #2d3748;" text="⚡ Prioritas:" />
                                            <ComboBox fx:id="priorityCombo" maxWidth="Infinity" minWidth="30.0" prefHeight="59.0" prefWidth="80.0" style="-fx-background-color: #f7fafc; -fx-border-color: #e2e8f0; -fx-border-width: 2; -fx-border-radius: 12; -fx-padding: 12; -fx-font-size: 14;" />
                                        </VBox>
                                    </HBox>

                                    <VBox spacing="12.0" />
                                </VBox>

                                <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20 0 0 0;">
                                    <Button fx:id="addDocumentBtn" onAction="#addDocument" prefHeight="55.0" prefWidth="240.0" style="-fx-background-color: #48bb78; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 15 30; -fx-background-radius: 25; -fx-effect: dropshadow(gaussian, rgba(72,187,120,0.5), 12, 0, 0, 6); -fx-cursor: hand;" text="📄 Tambah ke Antrian">
                                        <font>
                                            <Font name="System Bold" size="16.0" />
                                        </font>
                                    </Button>
                                    <Button fx:id="openDocumentButton" onAction="#viewFullDocument" prefHeight="56.0" prefWidth="240.0" style="-fx-background-color: #4299e1; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 15 30; -fx-background-radius: 25; -fx-effect: dropshadow(gaussian, rgba(66,153,225,0.4), 10, 0, 0, 5); -fx-cursor: hand;" text="👁 Lihat Dokumen" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button fx:id="closeButton" onAction="#closeApplication" prefHeight="55.0" prefWidth="240.0" style="-fx-background-color: #f56565; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 15 30; -fx-background-radius: 25; -fx-effect: dropshadow(gaussian, rgba(245,101,101,0.4), 10, 0, 0, 5); -fx-cursor: hand;" text="❌ Tutup">
                                        <font>
                                            <Font name="System Bold" size="16.0" />
                                        </font>
                                    </Button>
                                </HBox>
                            </VBox>
                        </VBox>
                    </content>
                </ScrollPane>
            </Tab>

            <Tab text="📋 Antrian Cetak">
                <content>
                    <VBox spacing="25.0" style="-fx-padding: 40; -fx-background-color: #f5f7fa;">
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-fill: #1e6091;" text="📋 Antrian Cetak">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Text>

                        <VBox prefHeight="180.0" prefWidth="1500.0" spacing="15.0" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);">
                            <Text strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-fill: #2d3748;" text="🖨 Status Printer">
                                <font>
                                    <Font name="System Bold" size="20.0" />
                                </font>
                            </Text>
                            <Label fx:id="printerStatusLabel" style="-fx-font-size: 18px; -fx-text-fill: #48bb78; -fx-font-weight: bold;" text="✅ Siap" />

                            <VBox fx:id="currentJobBox" spacing="8.0" style="-fx-background-color: #1e6091; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(102,126,234,0.3), 8, 0, 0, 4);" visible="false">
                                <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16;" text="🔄 Sedang Mencetak:" />
                                <Label fx:id="currentJobLabel" style="-fx-text-fill: #e8e8e8; -fx-font-size: 14;" />
                            </VBox>
                        </VBox>

                        <HBox spacing="15" style="-fx-padding: 10 0;">
                            <Button fx:id="cancelSelectedQueueButton" disable="true" minWidth="100.0" onAction="#cancelSelectedQueue" prefHeight="50.0" prefWidth="200.0" style="-fx-background-color: #ed8936; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 25; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(237,137,54,0.4), 8, 0, 0, 4); -fx-cursor: hand;" text="⚠ Batalkan Terpilih" />
                            <Button onAction="#cancelAllQueue" prefHeight="50.0" prefWidth="200.0" style="-fx-background-color: #f56565; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 25; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(245,101,101,0.4), 8, 0, 0, 4); -fx-cursor: hand;" text="🗑 Batalkan Semua" />
                            <Button onAction="#cancelEverything" prefHeight="50.0" prefWidth="200.0" style="-fx-background-color: #718096; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 25; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(113,128,150,0.4), 8, 0, 0, 4); -fx-cursor: hand;" text="🚫 Stop Semua" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="startPrintButton" minHeight="50.0" onAction="#startPrint" prefHeight="30.0" prefWidth="200.0" style="-fx-background-color: #48bb78; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 25; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(72,187,120,0.5), 10, 0, 0, 5); -fx-cursor: hand; -fx-font-size: 16;" text="🚀 Mulai Mencetak" />
                        </HBox>

                        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="queueContainer" spacing="20.0" style="-fx-padding: 15;" />
                            </content>
                        </ScrollPane>
                    </VBox>
                </content>
            </Tab>

            <Tab text="📊 Monitoring">
                <content>
                    <VBox spacing="30.0" style="-fx-padding: 40; -fx-background-color: #f5f7fa;">
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-fill: #1e6091;" text="📊 Dashboard Monitoring">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Text>

                        <GridPane hgap="25.0" vgap="25.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0" />
                                <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0" />
                                <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0" />
                                <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints vgrow="SOMETIMES" />
                            </rowConstraints>

                            <VBox alignment="CENTER" maxHeight="130.0" minHeight="100.0" prefHeight="108.0" prefWidth="198.0" spacing="15.0" style="-fx-background-color: #1e6091; -fx-padding: 25; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(102,126,234,0.3), 15, 0, 0, 8);" GridPane.columnIndex="0">
                                <Label fx:id="totalDocsLabel" style="-fx-font-size: 36px; -fx-text-fill: white; -fx-font-weight: bold;" text="0" />
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #e8e8e8; -fx-font-size: 14;" text="Total Dokumen" />
                            </VBox>

                            <VBox alignment="CENTER" maxHeight="130.0" minHeight="130.0" prefHeight="130.0" spacing="15.0" style="-fx-background-color: #48bb78; -fx-padding: 25; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(72,187,120,0.3), 15, 0, 0, 8);" GridPane.columnIndex="1">
                                <Label fx:id="completedDocsLabel" style="-fx-font-size: 36px; -fx-text-fill: white; -fx-font-weight: bold;" text="0" />
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #e8e8e8; -fx-font-size: 14;" text="Selesai Dicetak" />
                            </VBox>

                            <VBox alignment="CENTER" maxHeight="130.0" minHeight="130.0" prefHeight="130.0" spacing="15.0" style="-fx-background-color: #ed8936; -fx-padding: 25; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(237,137,54,0.3), 15, 0, 0, 8);" GridPane.columnIndex="2">
                                <Label fx:id="waitingDocsLabel" style="-fx-font-size: 36px; -fx-text-fill: white; -fx-font-weight: bold;" text="0" />
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #e8e8e8; -fx-font-size: 14;" text="Menunggu Antrian" />
                            </VBox>

                            <VBox alignment="CENTER" maxHeight="130.0" minHeight="130.0" prefHeight="130.0" spacing="15.0" style="-fx-background-color: #4299e1; -fx-padding: 25; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(66,153,225,0.3), 15, 0, 0, 8);" GridPane.columnIndex="3">
                                <Label fx:id="totalPagesLabel" style="-fx-font-size: 36px; -fx-text-fill: white; -fx-font-weight: bold;" text="0" />
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #e8e8e8; -fx-font-size: 14;" text="Total Salinan" />
                            </VBox>
                        </GridPane>

                        <VBox spacing="20.0" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);">
                            <Text strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-fill: #2d3748;" text="⚡ Prioritas Dokumen">
                                <font>
                                    <Font name="System Bold" size="20.0" />
                                </font>
                            </Text>
                            <HBox spacing="25">
                                <VBox alignment="CENTER" spacing="5">
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #e53e3e; -fx-font-size: 16;" text="🔴 Urgent" />
                                    <Label fx:id="urgentCountLabel" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #e53e3e;" text="0" />
                                </VBox>
                                <VBox alignment="CENTER" spacing="5">
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #dd6b20; -fx-font-size: 16;" text="🟠 Tinggi" />
                                    <Label fx:id="highPriorityCountLabel" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #dd6b20;" text="0" />
                                </VBox>
                                <VBox alignment="CENTER" spacing="5">
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #3182ce; -fx-font-size: 16;" text="🔵 Normal" />
                                    <Label fx:id="normalPriorityCountLabel" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #3182ce;" text="0" />
                                </VBox>
                                <VBox alignment="CENTER" spacing="5">
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #4a5568; -fx-font-size: 16;" text="⚫ Rendah" />
                                    <Label fx:id="lowPriorityCountLabel" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #4a5568;" text="0" />
                                </VBox>
                            </HBox>
                        </VBox>

                        <VBox prefHeight="165.0" prefWidth="866.0" spacing="20.0" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);">

                            <GridPane hgap="30.0" vgap="15.0">
                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #4a5568;" text="Status Printer:" />
                                    <Label fx:id="monitorPrinterStatusLabel" style="-fx-font-size: 16; -fx-text-fill: #48bb78; -fx-font-weight: bold;" text="✅ Siap" />
                                </VBox>
                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #4a5568;" text="Dokumen dalam Antrian:" />
                                    <Label fx:id="queueCountLabel" style="-fx-font-size: 16; -fx-text-fill: #2d3748; -fx-font-weight: bold;" text="0" />
                                </VBox>
                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1">
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #4a5568;" text="Estimasi Waktu Tunggu:" />
                                    <Label fx:id="estimatedWaitLabel" style="-fx-font-size: 16; -fx-text-fill: #2d3748; -fx-font-weight: bold;" text="0 menit" />
                                </VBox>
                        <columnConstraints>
                           <ColumnConstraints />
                           <ColumnConstraints />
                        </columnConstraints>
                        <rowConstraints>
                           <RowConstraints />
                           <RowConstraints />
                        </rowConstraints>
                            </GridPane>
                        </VBox>
                    </VBox>
                </content>
            </Tab>

            <Tab text="📚 Riwayat">
                <content>
                    <VBox spacing="25.0" style="-fx-padding: 40; -fx-background-color: #f5f7fa;">
                        <HBox alignment="CENTER_LEFT" spacing="25.0">
                            <Text strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-fill: #1e6091;" text="📚 Riwayat Cetak Dokumen">
                                <font>
                                    <Font name="System Bold" size="28.0" />
                                </font>
                            </Text>
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="clearHistoryBtn" onAction="#clearHistory" prefWidth="200.0" style="-fx-background-color: #ed8936; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 25; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(237,137,54,0.4), 8, 0, 0, 4); -fx-cursor: hand;" text="🗑 Bersihkan Riwayat" />
                            <Button fx:id="viewHistoryBtn" onAction="#viewHistory" prefWidth="200.0" style="-fx-background-color: #4299e1; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 25; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(66,153,225,0.4), 8, 0, 0, 4); -fx-cursor: hand;" text="👁 Lihat Laporan">
                                <font>
                                    <Font name="System Bold" size="12.0" />
                                </font>
                            </Button>
                        </HBox>

                        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="historyContainer" spacing="20.0" style="-fx-padding: 15;" />
                            </content>
                        </ScrollPane>
                    </VBox>
                </content>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
